# Copy to .env.local and fill in your own values. Never commit real secrets.

# Supabase (shared database for jobs and generations)
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Brandfetch brand lookup (optional; the Codex fallback covers misses)
BRANDFETCH_API_KEY=

# Generation rate limit per day
RATE_LIMIT_GEN_PER_DAY=

# rolecraft-codex agent runtime. Defaults to http://localhost:8443 when unset.
VPS_BASE_URL=http://localhost:8443
# Must match the bearer secret configured on the rolecraft-codex service.
VPS_SHARED_SECRET=
